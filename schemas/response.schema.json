{
  "type": "object",
  "required": [
    "protocol",
    "id",
    "candidate",
    "response",
    "checkpoint"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "arquia.io/1"
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "candidate": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "commands",
        "observed"
      ],
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "op",
              "authority_epoch",
              "grant",
              "effect",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": [
                  "dispatch",
                  "complete",
                  "alternate_commit"
                ]
              },
              "authority_epoch": {
                "type": "integer"
              },
              "grant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "effect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "phase": {
                "enum": [
                  "dispatch",
                  "start"
                ]
              }
            }
          }
        },
        "observed": {
          "type": "object",
          "required": [
            "active_grants",
            "outcomes",
            "incidents"
          ],
          "additionalProperties": false,
          "properties": {
            "active_grants": {
              "type": "array"
            },
            "outcomes": {
              "type": "object"
            },
            "incidents": {
              "type": "array"
            }
          }
        }
      }
    },
    "checkpoint": true
  }
}
