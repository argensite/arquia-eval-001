        "op": "external_commit",
        "effect": "e1"
      },
      {
        "op": "revoke",
        "grant": "g1"
      },
      {
        "op": "receipt",
        "receipt_id": "r1",
        "grant": "g1",
        "effect": "e1",
        "source": "independent_observer"
      },
      {
        "op": "dispatch",
        "grant": "g1",
        "effect": "e2"
      }
